<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>机械臂全功能控制套件</AssemblyName>
    <RootNamespace>ArmControlSuite</RootNamespace>
    <Version>5.2.0</Version>
    <Product>机械臂全功能控制套件</Product>
    <Description>串口 / 蓝牙 BLE / 经典 SPP 三模通信 · 16 通道机械臂全功能上位机控制系统 (固件 V4.12)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
    <PackageReference Include="System.Management" Version="10.0.15" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>
