<ui:FluentWindow x:Class="ArmControlSuite.Views.Dialogs.BleCharSelectorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="配置蓝牙透传服务特性"
                 Width="480"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource AppCanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="配置蓝牙透传服务特性"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Padding="14,6" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ui:SymbolIcon Symbol="BluetoothConnected24" FontSize="22" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="绑定蓝牙 GATT 数据通道"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="请为当前蓝牙设备绑定数据发送 (TX) 与状态接收 (RX) 特性："
                       FontSize="13"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <TextBlock Text="TX 写入特性 (Write)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding WriteCharacteristics}"
                      SelectedItem="{Binding SelectedWriteCharacteristic}"
                      DisplayMemberPath="DisplayText"
                      Margin="0,0,0,12" />

            <TextBlock Text="RX 通知特性 (Notify)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding NotifyCharacteristics}"
                      SelectedItem="{Binding SelectedNotifyCharacteristic}"
                      DisplayMemberPath="DisplayText"
                      Margin="0,0,0,10" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource AppDangerBrush}"
                       FontSize="12"
                       Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <ui:Button Content="取消连接"
                           Style="{StaticResource SoftOutlineButtonStyle}"
                           Click="CancelButton_Click"
                           Padding="14,6"
                           Margin="0,0,10,0" />
                <ui:Button Content="确认绑定"
                           Icon="{ui:SymbolIcon CheckmarkCircle20}"
                           Appearance="Primary"
                           Click="ConfirmButton_Click"
                           Padding="16,6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
