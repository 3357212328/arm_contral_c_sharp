<ui:FluentWindow x:Class="ArmControlSuite.Views.Dialogs.ConfirmDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="450"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource AppCanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Padding="14,6" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ui:SymbolIcon x:Name="DialogIcon" FontSize="24" Margin="0,0,8,0" />
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="16.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="MessageTextBlock"
                       FontSize="13.5"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消"
                           Style="{StaticResource SoftOutlineButtonStyle}"
                           Click="CancelButton_Click"
                           Padding="14,6"
                           Margin="0,0,10,0" />
                <ui:Button x:Name="ConfirmButton"
                           Click="ConfirmButton_Click"
                           Padding="16,6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
