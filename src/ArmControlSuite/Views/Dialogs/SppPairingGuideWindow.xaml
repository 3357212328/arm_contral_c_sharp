<ui:FluentWindow x:Class="ArmControlSuite.Views.Dialogs.SppPairingGuideWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="经典蓝牙 SPP 配对与连接说明"
                 Width="470"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource AppCanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="经典蓝牙 SPP 连接说明"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Padding="14,6" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ui:SymbolIcon Symbol="Bluetooth24" FontSize="22" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="经典蓝牙 SPP (HC-05 / JDY-31) 连接说明"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Style="{StaticResource SubtleCardStyle}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="1. 先在 Windows 系统设置「蓝牙和其他设备」中搜索并配对模块（常见默认密码为 1234 或 0000）。"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <TextBlock Text="2. 方式一（推荐）：配对成功后系统会自动生成虚拟串口（COMx），可直接切回「串口」模式选择对应 COM 口连接。"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <TextBlock Text="3. 方式二（直连 RFCOMM）：在此填入模块 6 字节 MAC 地址（形如 AA:BB:CC:DD:EE:FF，也可点击「已配对」按钮快速读取）并选择通道 1 直接建立蓝牙 Socket 连接。"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ui:Button Content="知道了"
                       Appearance="Primary"
                       HorizontalAlignment="Right"
                       Click="CloseButton_Click"
                       Padding="18,6" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
