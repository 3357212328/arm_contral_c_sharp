<ui:FluentWindow x:Class="ArmControlSuite.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tabs="clr-namespace:ArmControlSuite.Views.Tabs"
                 Title="机械臂全功能控制套件 V5.2"
                 Width="1380"
                 Height="880"
                 MinWidth="1080"
                 MinHeight="660"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 Background="{DynamicResource AppCanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部现代化标题导航栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppHeaderBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <ui:TitleBar x:Name="AppTitleBar"
                         Height="64"
                         Padding="18,6,10,6">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,6,0,6">
                        <Border Width="36" Height="36" CornerRadius="9" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Image Source="/机械臂全功能控制套件;component/Assets/icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="机械臂全功能控制套件"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AppAccentBadgeBrush}"
                                        CornerRadius="6"
                                        Padding="8,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="V5.2 · 固件V4.12"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="串口/BLE/SPP三模通信 · 16通道舵机姿态控制 · 序列插入与倍速回放 · 环境监控"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:TitleBar.Header>

                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- 连接状态胶囊 -->
                        <Border Background="{DynamicResource AppControlBgBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,5"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionPulseDot"
                                         Width="9"
                                         Height="9"
                                         Fill="{Binding ConnDotColor, Converter={StaticResource HexToBrush}}"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnStatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 查询状态按钮 -->
                        <ui:Button Content="查询状态"
                                   Icon="{ui:SymbolIcon ArrowSync20}"
                                   Command="{Binding QueryStatusCommand}"
                                   Style="{StaticResource SoftOutlineButtonStyle}"
                                   Height="32"
                                   Padding="11,0"
                                   FontSize="12"
                                   ToolTip="向 MCU 发送 status 指令刷新状态"
                                   Margin="0,0,8,0" />

                        <!-- 明暗主题切换按钮 -->
                        <ui:Button Command="{Binding ToggleThemeCommand}"
                                   Style="{StaticResource SoftOutlineButtonStyle}"
                                   Width="32"
                                   Height="32"
                                   Padding="0"
                                   ToolTip="切换浅色 / 深色外观">
                            <ui:SymbolIcon FontSize="17" Foreground="{DynamicResource AppTextPrimaryBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="WeatherMoon20" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                <Setter Property="Symbol" Value="WeatherSunny20" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Border>

        <!-- 主体工作区 + 底部可拖拽日志面板 -->
        <Grid x:Name="WorkspaceRootGrid" Grid.Row="1" Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="10" />
                <RowDefinition x:Name="LogDrawerRow" Height="230" MinHeight="46" />
            </Grid.RowDefinitions>

            <!-- 上半部分：左侧边栏 + 右侧主 Tab 工作区 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="344" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧边栏 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 1. 设备连接配置卡片 -->
                        <Border Style="{StaticResource SectionCardStyle}" Padding="13,11" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <ui:SymbolIcon Symbol="PlugConnected20" FontSize="17" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="设备连接配置"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                </StackPanel>

                                <!-- 三模切换分段器 -->
                                <Border Background="{DynamicResource AppSubtleCardBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="3"
                                        Margin="0,0,0,9"
                                        IsEnabled="{Binding CanEditConnectionSettings}">
                                    <UniformGrid Columns="3">
                                        <RadioButton Style="{StaticResource SegmentRadioStyle}"
                                                     GroupName="ConnMode"
                                                     IsChecked="{Binding SelectedConnectionMode, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="UsbPlug20" FontSize="14" Margin="0,0,5,0" />
                                                <TextBlock Text="串口" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SegmentRadioStyle}"
                                                     GroupName="ConnMode"
                                                     IsChecked="{Binding SelectedConnectionMode, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Bluetooth20" FontSize="14" Margin="0,0,5,0" />
                                                <TextBlock Text="蓝牙BLE" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SegmentRadioStyle}"
                                                     GroupName="ConnMode"
                                                     IsChecked="{Binding SelectedConnectionMode, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="BluetoothConnected20" FontSize="14" Margin="0,0,5,0" />
                                                <TextBlock Text="经典SPP" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>

                                <!-- 串口参数面板 -->
                                <StackPanel Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{Binding CanEditConnectionSettings}"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="串口端口" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding SerialPorts}"
                                                  SelectedItem="{Binding SelectedSerialPort}"
                                                  DisplayMemberPath="DisplayText" />
                                        <ui:Button Grid.Column="2"
                                                   Command="{Binding RefreshSerialPortsCommand}"
                                                   Style="{StaticResource SoftOutlineButtonStyle}"
                                                   Width="36"
                                                   Height="36"
                                                   Padding="0"
                                                   ToolTip="刷新可用串口列表">
                                            <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="16" />
                                        </ui:Button>
                                    </Grid>

                                    <TextBlock Text="通信波特率" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding BaudRates}"
                                              SelectedItem="{Binding SelectedBaudRate}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0} bps}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 蓝牙 BLE 参数面板 -->
                                <StackPanel Visibility="{Binding IsBleMode, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{Binding CanEditConnectionSettings}"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="蓝牙 BLE 设备" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding BleDevices}"
                                              SelectedItem="{Binding SelectedBleDevice}"
                                              DisplayMemberPath="DisplayText"
                                              Margin="0,0,0,8" />

                                    <TextBlock Text="模块透传预设" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding BlePresets}"
                                              SelectedItem="{Binding SelectedBlePreset}"
                                              Margin="0,0,0,8" />

                                    <ui:Button Content="{Binding BleScanButtonText}"
                                               Icon="{ui:SymbolIcon BluetoothSearching20}"
                                               Command="{Binding ScanBleCommand}"
                                               IsEnabled="{Binding IsBleScanning, Converter={StaticResource InvBool}}"
                                               Style="{StaticResource SoftOutlineButtonStyle}"
                                               HorizontalAlignment="Stretch"
                                               Height="34" />
                                </StackPanel>

                                <!-- 经典蓝牙 SPP 参数面板 -->
                                <StackPanel Visibility="{Binding IsSppMode, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{Binding CanEditConnectionSettings}"
                                            Margin="0,0,0,10">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="经典蓝牙 MAC 地址" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" DockPanel.Dock="Left" />
                                        <Button Content="读取已配对"
                                                Command="{Binding LoadPairedSppDevicesCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                FontSize="11"
                                                Foreground="{DynamicResource AppAccentBrush}"
                                                DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                ToolTip="读取 Windows 中已配对的经典蓝牙设备 MAC 地址" />
                                    </DockPanel>
                                    <ui:TextBox Text="{Binding SppMacAddress, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="如 AA:BB:CC:DD:EE:FF"
                                                FontFamily="Consolas"
                                                FontSize="12.5"
                                                LostFocus="SppMacTextBox_LostFocus"
                                                Margin="0,0,0,8" />

                                    <ComboBox ItemsSource="{Binding PairedSppDevices}"
                                              SelectedItem="{Binding SelectedPairedSppDevice}"
                                              DisplayMemberPath="DisplayText"
                                              Margin="0,0,0,8">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PairedSppDevices.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>

                                    <TextBlock Text="RFCOMM 通道" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding RfcommChannels}"
                                                  SelectedItem="{Binding SelectedSppChannel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=通道 {0}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ui:Button Grid.Column="2"
                                                   Command="{Binding ShowSppPairingGuideCommand}"
                                                   Style="{StaticResource SoftOutlineButtonStyle}"
                                                   Width="36"
                                                   Height="36"
                                                   Padding="0"
                                                   ToolTip="查看经典蓝牙 (HC-05 / JDY-31) 配对与连接说明">
                                            <ui:SymbolIcon Symbol="Info20" FontSize="16" />
                                        </ui:Button>
                                    </Grid>
                                </StackPanel>

                                <!-- 建立连接 / 断开连接主按钮 -->
                                <ui:Button Content="{Binding ConnectButtonText}"
                                           Command="{Binding ToggleConnectionCommand}"
                                           IsEnabled="{Binding CanToggleConnection}"
                                           HorizontalAlignment="Stretch"
                                           Height="36"
                                           FontWeight="SemiBold">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Setter Property="Icon" Value="{ui:SymbolIcon PlugConnected20}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Appearance" Value="Danger" />
                                                    <Setter Property="Icon" Value="{ui:SymbolIcon PlugDisconnected20}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <!-- 2. 实时遥测状态卡片 -->
                        <Border Style="{StaticResource SectionCardStyle}" Padding="13,11">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <ui:SymbolIcon Symbol="HeartPulse20" FontSize="17" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="实时遥测状态"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                </StackPanel>

                                <!-- 温度与湿度双指标小卡 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SubtleCardStyle}" Padding="9,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AppCardBrush}" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Temperature20" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Foreground" Value="#F59E0B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTempAlarm}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="环境温度" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SidebarTempText}" FontSize="16.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTempAlarm}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SubtleCardStyle}" Padding="9,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AppCardBrush}" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Drop20" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Foreground" Value="#0EA5E9" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHumiAlarm}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="环境湿度" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SidebarHumiText}" FontSize="16.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHumiAlarm}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 状态行：运行模式 / 序列状态 / 已录步数 -->
                                <Border Background="{DynamicResource AppSubtleCardBrush}" CornerRadius="8" Padding="10,5.5" Margin="0,0,0,5">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                            <ui:SymbolIcon Symbol="Grid20" FontSize="15" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="运行模式" FontSize="12.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource AppAccentBadgeBrush}"
                                                CornerRadius="6"
                                                Padding="9,2">
                                            <TextBlock Text="{Binding ModeDisplayText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppAccentBrush}" />
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <Border Background="{DynamicResource AppSubtleCardBrush}" CornerRadius="8" Padding="10,5.5" Margin="0,0,0,5">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                            <ui:SymbolIcon Symbol="Play20" FontSize="15" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="序列状态" FontSize="12.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding PlaybackStatusDisplayText}"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding PlaybackStatusKind, Converter={StaticResource PlayStatusToBrush}}" />
                                    </DockPanel>
                                </Border>

                                <Border Background="{DynamicResource AppSubtleCardBrush}" CornerRadius="8" Padding="10,5.5" Margin="0,0,0,8">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                            <ui:SymbolIcon Symbol="ClipboardTaskListLtr20" FontSize="15" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="已录步数" FontSize="12.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding RecordedStepsSidebarText}"
                                                   DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    </DockPanel>
                                </Border>

                                <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,8" />

                                <!-- 实时指令同步开关 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="实时指令同步" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding SyncHintText}" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     IsChecked="{Binding IsSyncEnabled, Mode=TwoWay}"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右侧主工作区卡片 (5 个 Tab) -->
                <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="14,6,14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部 Tab 导航条 -->
                        <UniformGrid Grid.Row="0" Columns="5">
                            <RadioButton Style="{StaticResource WorkspaceTabRadioStyle}"
                                         GroupName="WorkspaceTabs"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Board20" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="状态仪表盘" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource WorkspaceTabRadioStyle}"
                                         GroupName="WorkspaceTabs"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Options20" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="手动姿态控制" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource WorkspaceTabRadioStyle}"
                                         GroupName="WorkspaceTabs"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=2}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play20" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="动作序列编排" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource WorkspaceTabRadioStyle}"
                                         GroupName="WorkspaceTabs"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=3}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="HeartPulse20" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="环境实时监控" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource WorkspaceTabRadioStyle}"
                                         GroupName="WorkspaceTabs"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=4}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings20" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="硬件系统设置" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <Border Grid.Row="1" Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,0" />

                        <!-- Tab 视图切换内容区 (支持方向滑入 + 淡入切换动画) -->
                        <Grid Grid.Row="2" Margin="0,6,0,0" ClipToBounds="True">
                            <tabs:DashboardView x:Name="TabDashboardView">
                                <tabs:DashboardView.Style>
                                    <Style TargetType="tabs:DashboardView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </tabs:DashboardView.Style>
                            </tabs:DashboardView>

                            <tabs:ManualControlView x:Name="TabManualView">
                                <tabs:ManualControlView.Style>
                                    <Style TargetType="tabs:ManualControlView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </tabs:ManualControlView.Style>
                            </tabs:ManualControlView>

                            <tabs:SequenceView x:Name="TabSequenceView">
                                <tabs:SequenceView.Style>
                                    <Style TargetType="tabs:SequenceView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </tabs:SequenceView.Style>
                            </tabs:SequenceView>

                            <tabs:MonitorView x:Name="TabMonitorView">
                                <tabs:MonitorView.Style>
                                    <Style TargetType="tabs:MonitorView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </tabs:MonitorView.Style>
                            </tabs:MonitorView>

                            <tabs:SettingsView x:Name="TabSettingsView">
                                <tabs:SettingsView.Style>
                                    <Style TargetType="tabs:SettingsView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </tabs:SettingsView.Style>
                            </tabs:SettingsView>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 拖拽分割条 -->
            <GridSplitter x:Name="LogGridSplitter"
                          Grid.Row="1"
                          Height="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Background="Transparent"
                          Cursor="SizeNS"
                          ToolTip="上下拖动调节日志高度 · 双击快速收起/展开"
                          MouseDoubleClick="LogHeader_MouseDoubleClick"
                          DragCompleted="LogGridSplitter_DragCompleted">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="GripPill"
                                    Width="54"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="{DynamicResource AppBorderStrongBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GripPill" Property="Width" Value="76" />
                                <Setter TargetName="GripPill" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 底部可收起通信日志与调试终端面板 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource AppCardBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 日志面板标题栏 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource AppSubtleCardBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧可双击标题及实时预览 -->
                            <Grid Grid.Column="0"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  MouseLeftButtonDown="LogTitle_MouseLeftButtonDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="WindowConsole20" FontSize="18" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="通信日志" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource AppAccentSubtleBrush}"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="{Binding LogCountText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#38BDF8" />
                                </Border>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding LogPreviewText}"
                                           FontFamily="{StaticResource DefaultAppFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                            </Grid>

                            <!-- 右侧日志操作工具组 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolToVis}}"
                                        Background="{DynamicResource AppCardBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,2,6,2"
                                        Height="28"
                                        Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="自动滚动"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <ui:ToggleSwitch IsChecked="{Binding IsAutoScroll, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ui:Button Content="复制"
                                           Icon="{ui:SymbolIcon Copy20}"
                                           Command="{Binding CopyAllLogsCommand}"
                                           Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolToVis}}"
                                           Style="{StaticResource SoftOutlineButtonStyle}"
                                           Height="28"
                                           Padding="10,0"
                                           FontSize="12"
                                           ToolTip="一键复制全部日志 (也可在日志区内拖拽选中多行后 Ctrl+C 复制)"
                                           Margin="0,0,6,0" />

                                <ui:Button Content="清空"
                                           Icon="{ui:SymbolIcon Delete20}"
                                           Command="{Binding ClearLogsCommand}"
                                           Style="{StaticResource SoftOutlineButtonStyle}"
                                           Height="28"
                                           Padding="10,0"
                                           FontSize="12"
                                           Margin="0,0,6,0" />

                                <ui:Button Content="导出"
                                           Icon="{ui:SymbolIcon Save20}"
                                           Command="{Binding ExportLogsCommand}"
                                           Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolToVis}}"
                                           Style="{StaticResource SoftOutlineButtonStyle}"
                                           Height="28"
                                           Padding="10,0"
                                           FontSize="12"
                                           Margin="0,0,6,0" />

                                <ui:Button Content="{Binding CollapseButtonText}"
                                           Command="{Binding ToggleLogCollapseCommand}"
                                           Height="28"
                                           Padding="10,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           ToolTip="收起或展开通信日志面板 (也可双击标题或上方拖拽条)">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource SoftOutlineButtonStyle}">
                                            <Setter Property="Icon" Value="{ui:SymbolIcon ChevronDown20}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLogCollapsed}" Value="True">
                                                    <Setter Property="Icon" Value="{ui:SymbolIcon ChevronUp20}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 深色终端日志正文 + 底部调试命令行 -->
                    <Grid x:Name="LogBodyGrid"
                          Grid.Row="1"
                          Background="#0F172A"
                          Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 空占位提示 -->
                        <StackPanel Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasLogs, Converter={StaticResource InvBoolToVis}}">
                            <ui:SymbolIcon Symbol="WindowConsole20" FontSize="30" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="暂无通信日志 · 连接串口、蓝牙 BLE 或经典 SPP 设备后将实时显示收发报文"
                                       FontSize="12"
                                       Foreground="#64748B" />
                        </StackPanel>

                        <!-- 彩色多行可选日志框 -->
                        <RichTextBox x:Name="LogRichTextBox"
                                     Grid.Row="0"
                                     IsReadOnly="True"
                                     IsDocumentEnabled="False"
                                     Background="#0F172A"
                                     Foreground="#E2E8F0"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource DefaultAppFont}"
                                     FontSize="12.5"
                                     Padding="12,8"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding HasLogs, Converter={StaticResource BoolToVis}}">
                            <FlowDocument FontFamily="{StaticResource DefaultAppFont}" LineHeight="20" TextAlignment="Left" />
                        </RichTextBox>

                        <!-- 快捷命令输入栏 -->
                        <Border Grid.Row="1"
                                Background="#0B1120"
                                BorderBrush="#1E293B"
                                BorderThickness="0,1,0,0"
                                Padding="10,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="CMD &gt;"
                                           FontFamily="{StaticResource DefaultAppFont}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="#38BDF8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <TextBox x:Name="QuickCommandInputBox"
                                         Grid.Column="1"
                                         Text="{Binding QuickCommandText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         Foreground="#F8FAFC"
                                         CaretBrush="#38BDF8"
                                         BorderThickness="0"
                                         FontFamily="{StaticResource DefaultAppFont}"
                                         FontSize="12.5"
                                         VerticalContentAlignment="Center"
                                         PreviewKeyDown="QuickCommandInputBox_PreviewKeyDown">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Resources>
                                                <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="输入调试指令回车发送 (如: help, status, speed 10, rec_insert 1, reset_arm)...  [↑/↓ 历史指令]"
                                                                   Foreground="#64748B"
                                                                   FontFamily="{StaticResource DefaultAppFont}"
                                                                   FontSize="12" />
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Style.Resources>
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background" Value="{StaticResource HintBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <ui:Button Grid.Column="2"
                                           Icon="{ui:SymbolIcon Send20}"
                                           Command="{Binding SendQuickCommandCommand}"
                                           Appearance="Transparent"
                                           Foreground="#38BDF8"
                                           Width="30"
                                           Height="28"
                                           Padding="0"
                                           ToolTip="发送指令" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 右上角悬浮 Toast 通知条 -->
        <Border x:Name="ToastBanner"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,20,0"
                Panel.ZIndex="100"
                CornerRadius="10"
                Padding="14,10"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonUp="Toast_MouseLeftButtonUp"
                Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.28" Color="#000000" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1E293B" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastError}" Value="True">
                            <Setter Property="Background" Value="#DC2626" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon FontSize="18" Margin="0,0,8,0">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="CheckmarkCircle20" />
                            <Setter Property="Foreground" Value="#34D399" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                    <Setter Property="Symbol" Value="Warning20" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           MaxWidth="460"
                           TextTrimming="CharacterEllipsis" />
                <ui:SymbolIcon Symbol="Dismiss16"
                               FontSize="14"
                               Foreground="#94A3B8"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
