<UserControl x:Class="ArmControlSuite.Views.Tabs.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,6,4,4">

            <!-- 标题栏 -->
            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <ui:SymbolIcon Symbol="Board20" FontSize="20" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="机械臂实时运行状态总览"
                               FontSize="15.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ui:Button DockPanel.Dock="Right"
                           Content="立即同步状态"
                           Icon="{ui:SymbolIcon ArrowSync20}"
                           Command="{Binding QueryStatusCommand}"
                           Style="{StaticResource SoftOutlineButtonStyle}"
                           Padding="12,5"
                           FontSize="12.5" />
            </DockPanel>

            <!-- 6 张 KPI 卡片 (3x2) -->
            <UniformGrid Columns="3" Margin="0,0,0,12">
                <!-- 1. 当前模式 -->
                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,8,8" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AppAccentSubtleBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Grid20" FontSize="20" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="当前模式" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{Binding DashModeText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,1" />
                            <TextBlock Text="固件 UI 模式 (0~10)" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. 播放状态 -->
                <Border Style="{StaticResource SubtleCardStyle}" Margin="4,0,4,8" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AppGreenTintBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Play20" FontSize="20" Foreground="{DynamicResource AppSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="播放状态" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{Binding PlaybackStatusDisplayText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{Binding PlaybackStatusKind, Converter={StaticResource PlayStatusToBrush}}"
                                       Margin="0,1" />
                            <TextBlock Text="动作组回放状态机" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. 已录制步数 -->
                <Border Style="{StaticResource SubtleCardStyle}" Margin="8,0,0,8" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AppPurpleTintBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ClipboardTaskListLtr20" FontSize="20" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="已录制步数" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{Binding DashStepsText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,1" />
                            <TextBlock Text="MCU 已录制关键帧容量" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. 环境温度 -->
                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,8,0" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AppTempTintBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Temperature20" FontSize="20" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="环境温度" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{Binding DashTempText}" FontSize="18" FontWeight="Bold" Margin="0,1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTempAlarm}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DashTempSubText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 5. 环境湿度 -->
                <Border Style="{StaticResource SubtleCardStyle}" Margin="4,0,4,0" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AppHumiTintBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Drop20" FontSize="20" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="环境湿度" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{Binding DashHumiText}" FontSize="18" FontWeight="Bold" Margin="0,1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHumiAlarm}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DashHumiSubText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 6. 活动舵机 -->
                <Border Style="{StaticResource SubtleCardStyle}" Margin="8,0,0,0" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AppTealTintBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="20" Foreground="#0D9488" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="活动舵机" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{Binding DashActiveCountText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,1" />
                            <TextBlock Text="{Binding DashActiveSubText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DashActiveSubText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 16 路舵机实时角度矩阵 -->
            <Border Style="{StaticResource SubtleCardStyle}" Padding="14">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <ui:SymbolIcon Symbol="Options20" FontSize="18" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="当前 16 路舵机实时角度矩阵"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource AppAccentBadgeBrush}"
                                CornerRadius="10"
                                Padding="10,3">
                            <TextBlock Text="{Binding DashFocusServoBadge}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppAccentBrush}" />
                        </Border>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding ServoChannels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" Rows="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3"
                                        Padding="9,7"
                                        CornerRadius="8"
                                        Background="{DynamicResource AppCardBrush}"
                                        Opacity="{Binding IsEnabled, Converter={StaticResource EnabledOpacity}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentFocus}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Code}" FontSize="11.5" FontWeight="Bold" DockPanel.Dock="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding AngleBadgeText}"
                                                       DockPanel.Dock="Right"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="Consolas"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        </DockPanel>

                                        <ProgressBar Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding Progress, Mode=OneWay}"
                                                     Height="5"
                                                     BorderThickness="0"
                                                     Background="{DynamicResource AppTrackBgBrush}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 等宽姿态快照行 -->
                    <Border Background="{DynamicResource AppCardBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7"
                            Margin="3,8,3,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DashPoseMonoText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="{DynamicResource AppTextSecondaryBrush}"
                                     AcceptsReturn="True"
                                     VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1"
                                       Content="复制快照"
                                       Icon="{ui:SymbolIcon Copy20}"
                                       Command="{Binding CopyPoseSnapshotCommand}"
                                       Style="{StaticResource SoftOutlineButtonStyle}"
                                       Padding="10,4"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
