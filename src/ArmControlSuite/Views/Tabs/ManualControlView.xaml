<UserControl x:Class="ArmControlSuite.Views.Tabs.ManualControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="2,6,2,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Text="16通道关节角度控制"
                           FontSize="15.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Border Background="{DynamicResource AppAccentBadgeBrush}"
                        CornerRadius="12"
                        Padding="10,3"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveServoSummaryText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppAccentBrush}" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ui:Button Content="全部归零 (0°)"
                           Icon="{ui:SymbolIcon ArrowReset20}"
                           Command="{Binding ResetAllZeroCommand}"
                           Style="{StaticResource SoftOutlineButtonStyle}"
                           Padding="12,5"
                           FontSize="12.5"
                           ToolTip="将所有已启用舵机角度设为 0°"
                           Margin="0,0,8,0" />
                <ui:Button Content="全部归中 (90°)"
                           Icon="{ui:SymbolIcon Target20}"
                           Style="{StaticResource SoftOutlineButtonStyle}"
                           Command="{Binding ResetAllCenterCommand}"
                           Padding="12,5"
                           FontSize="12.5"
                           ToolTip="将所有已启用舵机角度设为 90°" />
                <ui:Button Content="应用所有角度"
                           Icon="{ui:SymbolIcon Send20}"
                           Appearance="Primary"
                           Command="{Binding ApplyAllAnglesCommand}"
                           Visibility="{Binding ShowNonSyncControls, Converter={StaticResource BoolToVis}}"
                           Padding="12,5"
                           FontSize="12.5"
                           Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 非同步模式提示横幅 -->
        <Border Grid.Row="1"
                Visibility="{Binding ShowNonSyncControls, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource AppWarningSubtleBrush}"
                BorderBrush="{DynamicResource AppWarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Info20" FontSize="17" Foreground="{DynamicResource AppWarningBrush}" Margin="0,0,8,0" />
                <TextBlock Text="当前处于【非同步模式】：调整滑块不会立即驱动硬件，请点击右侧「应用所有角度」统一下发。"
                           FontSize="12"
                           Foreground="{DynamicResource AppWarningBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 16 路舵机控制网格 (左 S01~S08, 右 S09~S16) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,2,2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <DataTemplate x:Key="ServoControlTileTemplate">
                        <Border Margin="0,0,0,6"
                                Padding="10,6"
                                CornerRadius="9"
                                Background="{DynamicResource AppSubtleCardBrush}"
                                Opacity="{Binding IsEnabled, Converter={StaticResource EnabledOpacity}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentFocus}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>

                                <!-- 通道徽章 S01~S16 -->
                                <Border Grid.Column="0"
                                        Width="40"
                                        Height="28"
                                        CornerRadius="7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AppControlBgBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppAccentBadgeBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrentFocus}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Code}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrentFocus}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- 角度滑块 -->
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="180"
                                        Value="{Binding SliderValue, Mode=TwoWay}"
                                        IsEnabled="{Binding IsEnabled}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center"
                                        Margin="8,0,8,0"
                                        Thumb.DragStarted="ServoSlider_DragStarted"
                                        Thumb.DragCompleted="ServoSlider_DragCompleted"
                                        PreviewMouseLeftButtonUp="ServoSlider_PreviewMouseLeftButtonUp"
                                        KeyUp="ServoSlider_KeyUp" />

                                <!-- 精密步进与数字框 -->
                                <Border Grid.Column="2"
                                        Height="30"
                                        Background="{DynamicResource AppCardBrush}"
                                        BorderBrush="{DynamicResource AppBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Command="{Binding StepDownCommand}"
                                                IsEnabled="{Binding IsEnabled}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                ToolTip="减小 1°">
                                            <ui:SymbolIcon Symbol="Subtract16" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        </Button>

                                        <Border Grid.Column="1" Background="{DynamicResource AppBorderBrush}" Margin="0,6" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBox Text="{Binding AngleText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsEnabled}"
                                                     Style="{StaticResource MonoSmallTextBoxStyle}"
                                                     Width="28"
                                                     MaxLength="3"
                                                     PreviewTextInput="AngleTextBox_PreviewTextInput"
                                                     KeyDown="AngleTextBox_KeyDown"
                                                     LostFocus="AngleTextBox_LostFocus" />
                                            <TextBlock Text="°"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Border Grid.Column="3" Background="{DynamicResource AppBorderBrush}" Margin="0,6" />

                                        <Button Grid.Column="4"
                                                Command="{Binding StepUpCommand}"
                                                IsEnabled="{Binding IsEnabled}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                ToolTip="增加 1°">
                                            <ui:SymbolIcon Symbol="Add16" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </Grid.Resources>

                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding LeftColumnServos}"
                              ItemTemplate="{StaticResource ServoControlTileTemplate}" />

                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding RightColumnServos}"
                              ItemTemplate="{StaticResource ServoControlTileTemplate}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
