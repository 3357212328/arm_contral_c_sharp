<UserControl x:Class="ArmControlSuite.Views.Tabs.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,6,4,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                <ui:SymbolIcon Symbol="HeartPulse20" FontSize="20" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="DHT11 温湿度传感器监控"
                           FontSize="15.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
            </StackPanel>

            <TextBlock Text="下位机每 2 秒自动采样一次 DHT11 温湿度数据。报警上限可在「硬件系统设置」页配置并写入 Flash。"
                       FontSize="12.5"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Margin="0,0,0,14" />

            <!-- 温度 / 湿度双卡 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 温度卡 -->
                <Border Grid.Column="0" Style="{StaticResource SubtleCardStyle}" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AppTempTintBrush}" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Temperature24" FontSize="22" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="环境实时温度"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding DashTempText}" FontSize="34" FontWeight="Bold" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTempAlarm}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ProgressBar Minimum="0"
                                     Maximum="1"
                                     Value="{Binding TempProgress, Mode=OneWay}"
                                     Height="10"
                                     BorderThickness="0"
                                     Background="{DynamicResource AppTrackBgBrush}"
                                     Margin="0,0,0,10">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#F59E0B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTempAlarm}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <DockPanel>
                            <TextBlock Text="传感器量程: 0 ~ 100 °C" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding DashTempSubText}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 湿度卡 -->
                <Border Grid.Column="2" Style="{StaticResource SubtleCardStyle}" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AppHumiTintBrush}" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Drop24" FontSize="22" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="环境实时湿度"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding DashHumiText}" FontSize="34" FontWeight="Bold" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0284C7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHumiAlarm}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ProgressBar Minimum="0"
                                     Maximum="1"
                                     Value="{Binding HumiProgress, Mode=OneWay}"
                                     Height="10"
                                     BorderThickness="0"
                                     Background="{DynamicResource AppTrackBgBrush}"
                                     Margin="0,0,0,10">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#0EA5E9" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHumiAlarm}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <DockPanel>
                            <TextBlock Text="传感器量程: 0 ~ 100 %" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding DashHumiSubText}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 安全状态 / 超限报警横幅 -->
            <Border Padding="18" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppSubtleCardBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAnyEnvAlarm}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppDangerSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AppCardBrush}" Margin="0,0,14,0">
                        <ui:SymbolIcon FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ShieldCheckmark20" />
                                    <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnyEnvAlarm}" Value="True">
                                            <Setter Property="Symbol" Value="Warning24" />
                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MonitorAlertTitle}" FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnyEnvAlarm}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding MonitorAlertDesc}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
