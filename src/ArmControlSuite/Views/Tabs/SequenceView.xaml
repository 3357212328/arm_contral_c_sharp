<UserControl x:Class="ArmControlSuite.Views.Tabs.SequenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,6,4,4">

            <!-- 第一部分：动作序列回放与倍速控制 -->
            <Border Style="{StaticResource SubtleCardStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <ui:SymbolIcon Symbol="Play20" FontSize="20" Foreground="{DynamicResource AppSuccessBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="动作序列回放与倍速控制"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource AppAccentBadgeBrush}"
                                CornerRadius="10"
                                Padding="10,3">
                            <TextBlock Text="{Binding SeqStepsBadgeText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppAccentBrush}" />
                        </Border>
                    </DockPanel>

                    <!-- 播放操作按钮行 -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button Content="开始播放"
                                   Icon="{ui:SymbolIcon Play20}"
                                   Appearance="Success"
                                   Command="{Binding PlaySequenceCommand}"
                                   Height="40"
                                   Padding="18,0"
                                   FontWeight="SemiBold"
                                   Margin="0,0,10,4" />
                        <ui:Button Content="暂停"
                                   Icon="{ui:SymbolIcon Pause20}"
                                   Style="{StaticResource SoftOutlineButtonStyle}"
                                   Command="{Binding PauseSequenceCommand}"
                                   Height="40"
                                   Padding="16,0"
                                   Margin="0,0,10,4" />
                        <ui:Button Content="继续播放"
                                   Icon="{ui:SymbolIcon FlashPlay20}"
                                   Style="{StaticResource SoftOutlineButtonStyle}"
                                   Command="{Binding ResumeSequenceCommand}"
                                   Height="40"
                                   Padding="16,0"
                                   Margin="0,0,10,4" />
                        <Button Command="{Binding StopSequenceCommand}"
                                Style="{StaticResource DangerOutlineButtonStyle}"
                                Height="40"
                                Padding="16,0"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Stop20" FontSize="17" Margin="0,0,6,0" />
                                <TextBlock Text="停止" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- 状态与播放倍速栏 -->
                    <Border Background="{DynamicResource AppCardBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <ui:SymbolIcon Symbol="{Binding PlaybackStatusKind, Converter={StaticResource PlayStatusToIcon}}"
                                               FontSize="18"
                                               Foreground="{Binding PlaybackStatusKind, Converter={StaticResource PlayStatusToBrush}}"
                                               Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SeqStatusText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding PlaybackStatusKind, Converter={StaticResource PlayStatusToBrush}}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                                <TextBlock Text="播放速度:"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <Border Background="{DynamicResource AppSubtleCardBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="3">
                                    <UniformGrid Columns="3">
                                        <RadioButton Content="0.5x 慢速"
                                                     GroupName="PlaybackSpeed"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding IsSpeed05x, Mode=TwoWay}"
                                                     Command="{Binding SetSpeedCommand}"
                                                     CommandParameter="0.5"
                                                     MinWidth="76" />
                                        <RadioButton Content="1.0x 标准"
                                                     GroupName="PlaybackSpeed"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding IsSpeed10x, Mode=TwoWay}"
                                                     Command="{Binding SetSpeedCommand}"
                                                     CommandParameter="1.0"
                                                     MinWidth="76" />
                                        <RadioButton Content="2.0x 倍速"
                                                     GroupName="PlaybackSpeed"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding IsSpeed20x, Mode=TwoWay}"
                                                     Command="{Binding SetSpeedCommand}"
                                                     CommandParameter="2.0"
                                                     MinWidth="76" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 第二部分：关键帧录制、插入与延时编排 -->
            <Border Style="{StaticResource SubtleCardStyle}" Padding="16">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <ui:SymbolIcon Symbol="Record20" FontSize="20" Foreground="{DynamicResource AppDangerBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="关键帧录制、插入与延时编排"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ui:Button Content="录制当前姿态为新步骤"
                                       Icon="{ui:SymbolIcon Record20}"
                                       Appearance="Primary"
                                       Command="{Binding RecordStepCommand}"
                                       Height="34"
                                       Padding="14,0"
                                       FontSize="13"
                                       Margin="0,0,8,0" />
                            <Button Command="{Binding ClearSequenceCommand}"
                                    Style="{StaticResource DangerOutlineButtonStyle}"
                                    Height="34"
                                    Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete20" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="清空全部序列" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 延时设置卡 -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource AppCardBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="步骤停留延时配置 (rec_delay)"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Style="{StaticResource SoftOutlineButtonStyle}"
                                               Command="{Binding AdjustDelayCommand}"
                                               CommandParameter="-1"
                                               Width="34"
                                               Height="34"
                                               Padding="0"
                                               ToolTip="减少 1 秒">
                                        <ui:SymbolIcon Symbol="Subtract20" FontSize="15" />
                                    </ui:Button>
                                    <TextBox Text="{Binding DelaySecondsText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="96"
                                             Height="34"
                                             Margin="6,0"
                                             FontFamily="Consolas"
                                             FontSize="13.5"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             MaxLength="3"
                                             ToolTip="延时秒数 (0~600s)"
                                             PreviewTextInput="NumericOnly_PreviewTextInput" />
                                    <TextBlock Text="秒"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ui:Button Style="{StaticResource SoftOutlineButtonStyle}"
                                               Command="{Binding AdjustDelayCommand}"
                                               CommandParameter="1"
                                               Width="34"
                                               Height="34"
                                               Padding="0"
                                               ToolTip="增加 1 秒">
                                        <ui:SymbolIcon Symbol="Add20" FontSize="15" />
                                    </ui:Button>
                                    <ui:Button Content="应用延时"
                                               Icon="{ui:SymbolIcon Timer20}"
                                               Style="{StaticResource SoftOutlineButtonStyle}"
                                               Command="{Binding ApplyDelayCommand}"
                                               Height="34"
                                               Padding="14,0"
                                               Margin="10,0,0,0"
                                               ToolTip="设置上一步录制步骤的停留延时 (rec_delay)" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 插入姿态卡 -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource AppCardBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="指定位置插入姿态 (rec_insert)"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Style="{StaticResource SoftOutlineButtonStyle}"
                                               Command="{Binding AdjustInsertPositionCommand}"
                                               CommandParameter="-1"
                                               Width="34"
                                               Height="34"
                                               Padding="0"
                                               ToolTip="前移 1 步">
                                        <ui:SymbolIcon Symbol="Subtract20" FontSize="15" />
                                    </ui:Button>
                                    <TextBox Text="{Binding InsertPositionText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="96"
                                             Height="34"
                                             Margin="6,0"
                                             FontFamily="Consolas"
                                             FontSize="13.5"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             MaxLength="2"
                                             ToolTip="位置 (1~50步)"
                                             PreviewTextInput="NumericOnly_PreviewTextInput" />
                                    <TextBlock Text="步"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ui:Button Style="{StaticResource SoftOutlineButtonStyle}"
                                               Command="{Binding AdjustInsertPositionCommand}"
                                               CommandParameter="1"
                                               Width="34"
                                               Height="34"
                                               Padding="0"
                                               ToolTip="后移 1 步">
                                        <ui:SymbolIcon Symbol="Add20" FontSize="15" />
                                    </ui:Button>
                                    <ui:Button Content="插入姿态"
                                               Icon="{ui:SymbolIcon AppsListDetail20}"
                                               Style="{StaticResource SoftOutlineButtonStyle}"
                                               Command="{Binding InsertStepCommand}"
                                               Height="34"
                                               Padding="14,0"
                                               Margin="10,0,0,0"
                                               ToolTip="在指定第 N 步前插入当前姿态 (rec_insert)" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
