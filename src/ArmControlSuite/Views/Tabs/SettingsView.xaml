<UserControl x:Class="ArmControlSuite.Views.Tabs.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,6,4,4">

            <!-- 1. 活动舵机通道掩码配置 (S01~S16) -->
            <Border Style="{StaticResource SubtleCardStyle}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <ui:SymbolIcon Symbol="DeveloperBoard20" FontSize="20" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="活动舵机通道掩码配置 (S01 ~ S16)"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ui:Button Content="全部启用"
                                       Icon="{ui:SymbolIcon CheckmarkCircle20}"
                                       Style="{StaticResource SoftOutlineButtonStyle}"
                                       Command="{Binding EnableAllServosCommand}"
                                       Height="32"
                                       Padding="12,0"
                                       FontSize="12.5"
                                       Margin="0,0,8,0" />
                            <Button Command="{Binding DisableAllServosCommand}"
                                    Style="{StaticResource DangerOutlineButtonStyle}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="15" Margin="0,0,5,0" />
                                    <TextBlock Text="全部禁用" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ui:Button Content="保存舵机配置至硬件"
                                       Icon="{ui:SymbolIcon Save20}"
                                       Appearance="Primary"
                                       Command="{Binding SaveServoConfigCommand}"
                                       Height="32"
                                       Padding="12,0"
                                       FontSize="12.5" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding ServoChannels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" Rows="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3"
                                        Padding="8,5"
                                        CornerRadius="8"
                                        Background="{DynamicResource AppCardBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1">
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Content="{Binding Code}"
                                              FontWeight="SemiBold"
                                              FontSize="12.5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 2. 温湿度报警阈值 + 硬件复位与固件调试 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 温湿度报警阈值 -->
                <Border Grid.Column="0" Style="{StaticResource SubtleCardStyle}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Warning20" FontSize="19" Foreground="#F59E0B" Margin="0,0,8,0" />
                            <TextBlock Text="温湿度安全报警阈值 (0 ~ 100)"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="设置 DHT11 报警上限并写入下位机 Flash，同时持久化至本地配置文件。"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,10,4">
                                <TextBlock Text="温度上限 (°C)" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding TempThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                            Icon="{ui:SymbolIcon Temperature16}"
                                            Width="128"
                                            MaxLength="3"
                                            PreviewTextInput="NumericOnly_PreviewTextInput" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,4">
                                <TextBlock Text="湿度上限 (%)" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding HumiThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                            Icon="{ui:SymbolIcon Drop16}"
                                            Width="128"
                                            MaxLength="3"
                                            PreviewTextInput="NumericOnly_PreviewTextInput" />
                            </StackPanel>
                            <ui:Button Content="保存阈值"
                                       Icon="{ui:SymbolIcon Checkmark20}"
                                       Appearance="Primary"
                                       Command="{Binding SaveThresholdsCommand}"
                                       Height="36"
                                       Padding="14,0"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,4"
                                       ToolTip="保存报警阈值并下发 set_thresh 至下位机" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 硬件复位与固件调试 -->
                <Border Grid.Column="2" Style="{StaticResource SubtleCardStyle}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Wrench20" FontSize="19" Foreground="#6366F1" Margin="0,0,8,0" />
                            <TextBlock Text="硬件复位与固件调试"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="恢复初始角度、查看下位机命令帮助，或将 MCU Flash 配置恢复出厂默认。"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="舵机复位"
                                       Icon="{ui:SymbolIcon ArrowClockwise20}"
                                       Appearance="Primary"
                                       Command="{Binding ResetArmCommand}"
                                       Height="36"
                                       Padding="14,0"
                                       Margin="0,0,8,4"
                                       ToolTip="下发 reset_arm，将所有舵机恢复至初始角度" />
                            <ui:Button Content="固件帮助"
                                       Icon="{ui:SymbolIcon ChatHelp20}"
                                       Style="{StaticResource SoftOutlineButtonStyle}"
                                       Command="{Binding SendHelpCommand}"
                                       Height="36"
                                       Padding="14,0"
                                       Margin="0,0,8,4"
                                       ToolTip="下发 help 指令并在下方日志查看固件命令表" />
                            <Button Command="{Binding ResetSystemCommand}"
                                    Style="{StaticResource DangerOutlineButtonStyle}"
                                    Height="36"
                                    Padding="14,0"
                                    Margin="0,0,0,4"
                                    ToolTip="清除下位机 Flash 全部配置并恢复出厂默认 (reset_system)">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning20" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="系统重置" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. 本地配置文件操作条 -->
            <Border Style="{StaticResource SubtleCardStyle}" Padding="14,10">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0">
                        <ui:Button Content="打开目录"
                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                   Style="{StaticResource SoftOutlineButtonStyle}"
                                   Command="{Binding OpenConfigDirectoryCommand}"
                                   Height="32"
                                   Padding="12,0"
                                   FontSize="12.5"
                                   Margin="0,0,8,0"
                                   ToolTip="打开配置文件所在目录" />
                        <ui:Button Content="保存配置"
                                   Icon="{ui:SymbolIcon Save20}"
                                   Style="{StaticResource SoftOutlineButtonStyle}"
                                   Command="{Binding SaveAllSettingsCommand}"
                                   Height="32"
                                   Padding="12,0"
                                   FontSize="12.5"
                                   Margin="0,0,8,0"
                                   ToolTip="立即将当前所有界面设置写入 arm_suite_config.json" />
                        <ui:Button Content="恢复默认"
                                   Icon="{ui:SymbolIcon ArrowReset20}"
                                   Style="{StaticResource SoftOutlineButtonStyle}"
                                   Command="{Binding ResetLocalConfigCommand}"
                                   Height="32"
                                   Padding="12,0"
                                   FontSize="12.5"
                                   ToolTip="将本地配置文件重置为初始默认参数" />
                    </StackPanel>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Settings20" FontSize="18" Foreground="#0D9488" Margin="0,0,8,0" />
                            <TextBlock Text="本地配置文件:"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{DynamicResource AppCardBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5">
                            <TextBox Text="{Binding SettingsFilePath, Mode=OneWay}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="{DynamicResource AppTextSecondaryBrush}"
                                     ToolTip="{Binding SettingsFilePath}" />
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
